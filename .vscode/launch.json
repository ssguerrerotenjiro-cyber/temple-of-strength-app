      "args": ["--dart-define=VISTA_PRUEBA=true"]
    },
    {
      "name": "Temple · con mi cuenta",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Temple · rápida como el APK (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    }
  ]
}
